# Node Environment
NODE_ENV=development
PORT=5000

# Database
# Local MongoDB: mongodb://localhost:27017/financial_tracker
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/financial_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/financial_tracker

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Configuration
# For local development: http://localhost:5173
# For production: https://your-frontend-app.vercel.app
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@wealthtracker.local
ADMIN_PASSWORD=AdminSecurePass123!
